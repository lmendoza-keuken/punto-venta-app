rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Windows installer binaries for auto-update.
    // Upload only from Console; app downloads with auth or downloadUrl token.
    match /releases/windows/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Existing default: any authenticated user can read/write the rest.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
